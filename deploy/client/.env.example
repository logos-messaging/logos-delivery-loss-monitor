# Copy to .env and edit.

# Release tag without the v; the image downloads and verifies that release's binary.
LOSSMON_VERSION=0.2.0

LOSSMON_SERVER_URL=https://lossmon.example.org
LOSSMON_LOCATION=eu
LOSSMON_TOKEN=

LOSSMON_PRESET=logos.dev
# Only for a preset other than logos.dev and logos.test: set it to that preset.
LOSSMON_ALLOW_PRESET=
LOSSMON_MODE=core
LOSSMON_ROLE=both
LOSSMON_RATE=0.5
