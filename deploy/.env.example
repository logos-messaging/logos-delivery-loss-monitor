# Copy to deploy/.env and edit. Tokens and the probe key live in deploy/secrets/ (see init-secrets.sh).

LOSSMON_PRESET=logos.dev
LOSSMON_CLUSTER_ID=3
LOSSMON_TOPICS=/lossmon/1/probe-0/raw
LOSSMON_LOCATIONS=af,as,eu,na,oc,sa
LOSSMON_MAX_RATE_PER_CLIENT=1.0
LOSSMON_MAX_RATE_TOTAL=20

LOSSMON_WINDOW=10m
LOSSMON_GRACE=30s
LOSSMON_HOLD=10m
LOSSMON_RECEIVER_WARMUP=30s
LOSSMON_MAX_CLOCK_OFFSET=60s
LOSSMON_LOSS_RATIO_WINDOW=1h

LOSSMON_LISTENER_LOCATION=eu
GRAFANA_ADMIN_PASSWORD=
LOSSMON_PUBLIC_HOST=lossmon.example.org

# Optional: version string baked into the client image, e.g. $(git -C ../client/vendor/logos-delivery describe --tags --always)
# LOSSMON_CLIENT_LD_VERSION=
