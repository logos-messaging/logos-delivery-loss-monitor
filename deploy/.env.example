# Copy to deploy/.env and edit. Tokens and the probe key live in deploy/secrets/ (see init-secrets.sh).

LOSSMON_PRESET=logos.dev
LOSSMON_CLUSTER_ID=3
LOSSMON_TOPICS=/lossmon/1/probe-0/raw
LOSSMON_LOCATIONS=af,as,eu,na,oc,sa
LOSSMON_MAX_RATE_PER_CLIENT=1.0
LOSSMON_MAX_RATE_TOTAL=20
LOSSMON_MAX_SESSIONS_PER_TOKEN=4

LOSSMON_WINDOW=10m
LOSSMON_GRACE=30s
LOSSMON_HOLD=10m
LOSSMON_RECEIVER_WARMUP=30s
LOSSMON_MAX_CLOCK_OFFSET=60s
LOSSMON_LOSS_RATIO_WINDOW=1h

LOSSMON_LISTENER_LOCATION=eu
GRAFANA_ADMIN_PASSWORD=

# Hostname only, no scheme and no port, e.g. lossmon.example.org. Required for the public profile or your own proxy.
LOSSMON_PUBLIC_HOST=

# Release tag of this checkout, without the v. Leave empty when not on a tag.
LOSSMON_SERVER_VERSION=

# Loopback ports, change them when 3000 or 8080 are taken on the host.
GRAFANA_PORT=3000
LOSSMON_SERVER_PORT=8080
